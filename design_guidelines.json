{
  "app_name": "Padaria Delícia & Cia",
  "context": "e-commerce",
  "theme": "light",
  "typography": {
    "heading_font": "Playfair Display",
    "body_font": "Plus Jakarta Sans",
    "hierarchy": {
      "h1": "text-4xl sm:text-5xl lg:text-6xl tracking-tight font-bold",
      "h2": "text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold",
      "h3": "text-xl sm:text-2xl font-semibold",
      "h4": "text-lg sm:text-xl font-semibold",
      "body": "text-base font-normal leading-relaxed",
      "small": "text-sm font-medium"
    }
  },
  "colors": {
    "archetype": "ORGANIC & EARTHY",
    "primary": "#D97706",
    "primary_hover": "#B45309",
    "background": "#FDFBF7",
    "surface": "#FFFFFF",
    "text_main": "#1C1917",
    "text_muted": "#78716C",
    "border": "#E7E5E4",
    "accent": "#92400E"
  },
  "grids": {
    "product_catalog": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6",
    "bento_hero": "grid grid-cols-1 lg:grid-cols-12 gap-8 items-center"
  },
  "layouts": {
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
    "header": "sticky top-0 z-50 backdrop-blur-xl bg-white/80 border-b border-amber-100"
  },
  "motion": {
    "hover": "transition-transform duration-200 hover:-translate-y-1",
    "click": "active:scale-95 transition-transform"
  },
  "accessibility": {
    "contrast_ratio_target": "WCAG AA minimum 4.5:1",
    "focus_state": "focus:ring-2 focus:ring-amber-500 focus:outline-none"
  },
  "image_urls": {
    "hero_bakery": "https://images.unsplash.com/photo-1583338917451-face2751d8d5?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTY2NzB8MHwxfHNlYXJjaHwzfHxiYWtlcnklMjBicmVhZklwYXN0cnklMjBjYWtlJTIwc2hvcHxlbnwwfHx8fDE3ODk2NDcyODZ8MA&ixlib=rb-4.1.0&q=85",
    "pao_queijo": "https://images.pexels.com/photos/38598140/pexels-photo-38598140.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940",
    "coxinha": "https://images.pexels.com/photos/33938859/pexels-photo-33938859.png?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940",
    "bolo": "https://images.pexels.com/photos/28729037/pexels-photo-28729037.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
  },
  "universal_guidelines_for_main_agent": [
    "Every interactive and key informational element MUST include a data-testid attribute.",
    "Do not use complete transparent background in header or overlays.",
    "Never use generic Inter font for headings; use Playfair Display or equivalent display font.",
    "Ensure WhatsApp checkout message is fully formatted with all items, quantites, delivery/pickup choice, address, and payment method.",
    "Include all products accurately matching the provided price list and options."
  ]
}